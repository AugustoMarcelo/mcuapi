{
  "name": "mcuapi-mcp",
  "version": "1.0.0",
  "description": "MCP server for managing MCU API data",
  "main": "dist/index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:pg --external:dotenv --external:@modelcontextprotocol/sdk --external:redis --external:zod",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.0.0",
    "pg": "^8.11.0",
    "redis": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
