    "/api/v1/movies/{movie_id}/streaming": {
      "get": {
        "tags": [
          "Streaming"
        ],
        "summary": "Where to watch a movie",
        "description": "Streaming availability for one title, grouped by region. Hand-curated: coverage is deliberately incomplete rather than guessed, so an absent title means \"not recorded yet\".",
        "parameters": [
          {
            "name": "movie_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "region",
            "in": "query",
            "description": "ISO 3166-1 alpha-2 country code, e.g. US or BR. Case-insensitive. Omit for every region.",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability grouped by region. An empty data array means no availability is recorded, not that the title is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingCollection"
                }
              }
            }
          },
          "400": {
            "description": "region was not a two-letter code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
