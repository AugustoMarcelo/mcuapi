              "minLength": 2,
              "maxLength": 2,
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability grouped by region. An empty data array means no availability is recorded, not that the title is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingCollection"
                }
              }
            }
          },
          "400": {
            "description": "region was not a two-letter code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/streaming/providers": {
      "get": {
        "tags": [
          "Streaming"
        ],
        "summary": "Regions and providers in use",
        "description": "Every region that has at least one recorded offer, and the distinct provider names. Use it to discover what the dataset currently covers.",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "description": "Narrow the provider list to one region.",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Known regions and providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingProviders"
                }
              }
            }
          },
          "400": {
            "description": "region was not a two-letter code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
