{
  "name": "mcuapi",
  "version": "3.0.0",
  "description": "A RESTFul API for MCU (Marvel Cinematic Universe)",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev:server": "tsx watch --inspect -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "start": "node dist/shared/infra/http/server.js",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typeorm:dev": "tsx -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm": "node ./node_modules/typeorm/cli.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts jest.config.js prettier.config.js",
    "lint:fix": "eslint src scripts jest.config.js prettier.config.js --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "check:surfaces": "tsx scripts/check-surface-parity.ts"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.2.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^14.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "supertest": "7.2.2",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^3.9.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.3"
  }
}
